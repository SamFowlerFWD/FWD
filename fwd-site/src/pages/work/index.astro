---
import Layout from '../../layouts/Layout.astro';
import SmartCTA from '../../components/interactive/SmartCTA.astro';
import { projects } from '../../data/projects';
import { INDUSTRIES } from '../../data/taxonomy';

const caseStudies = projects.filter(p => p.caseStudy);
const allProjects = projects.filter(p => !p.caseStudy);
const industryLabel = (p: (typeof projects)[number]) =>
  p.industries.length ? INDUSTRIES[p.industries[0]].label : (p.location ?? 'Norfolk');
---

<Layout
  title="My Work | Web Development & Automation Projects"
  description="Real projects, real results. Websites, apps, booking systems, and automation built for UK businesses. Based in Norwich, working UK-wide."
  keywords="web development portfolio, uk business websites, booking system development, case studies, norfolk web design"
>

  <!-- Hero Section -->
  <section class="relative py-20 bg-slate-900">
    <div class="absolute inset-0 bg-ai-mesh opacity-20"></div>
    <div class="container relative z-10 mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center text-white">
        <h1 class="text-5xl lg:text-6xl font-bold mb-6">
          Our <span class="text-amber-400">Work</span>
        </h1>
        <p class="text-xl text-gray-100 mb-8">
          Real projects built for real businesses. Have a look at what I've done and see if it gives you ideas for your own project.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/equestrian" class="bg-white/10 border border-white/30 hover:bg-white hover:text-slate-900 text-white text-sm font-semibold px-4 py-2 rounded-full transition-colors">Equestrian work</a>
          <a href="/engineering" class="bg-white/10 border border-white/30 hover:bg-white hover:text-slate-900 text-white text-sm font-semibold px-4 py-2 rounded-full transition-colors">Engineering &amp; manufacturing work</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Case Studies -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <span class="bg-amber-100 text-amber-800 text-sm font-semibold px-4 py-2 rounded-full">Case Studies</span>
          <h2 class="text-3xl font-bold text-slate-900 mt-4">Featured Projects</h2>
          <p class="text-gray-600 mt-2">Read the full story behind these builds.</p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {caseStudies.map(project => (
            <a href={`/blog/${project.caseStudy}`} class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-shadow group">
              <div class="h-48 relative overflow-hidden">
                <img
                  src={project.image}
                  alt={project.alt}
                  class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300"
                  width="400"
                  height="192"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute top-4 right-4 bg-amber-500 text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg">
                  Case Study
                </div>
              </div>
              <div class="p-6">
                <div class="flex items-center gap-2 mb-3">
                  <span class="bg-slate-100 text-slate-700 text-xs font-semibold px-2 py-1 rounded-full">{industryLabel(project)}</span>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-amber-600 transition-colors">{project.name}</h3>
                <p class="text-gray-600 text-sm mb-4">{project.summary}</p>
                <div class="flex flex-wrap gap-1 mb-4">
                  {project.work.map(service => (
                    <span class="text-xs text-gray-500 bg-gray-100 px-2 py-0.5 rounded">{service}</span>
                  ))}
                </div>
                <span class="inline-flex items-center gap-1 text-ai-purple font-semibold text-sm">
                  Read Case Study
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- All Projects -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-slate-900 mb-4">All Projects</h2>
          <p class="text-gray-600">Websites, apps, and digital solutions delivered for businesses across the UK.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {allProjects.map(project => (
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow group">
              <div class="h-40 relative overflow-hidden">
                <img
                  src={project.image}
                  alt={project.alt}
                  class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300"
                  width="300"
                  height="160"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="p-4">
                <div class="flex items-center gap-2 mb-2">
                  <span class="bg-slate-100 text-slate-700 text-xs font-semibold px-2 py-0.5 rounded-full">{industryLabel(project)}</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-1">{project.name}</h3>
                <p class="text-gray-600 text-sm mb-3">{project.summary}</p>
                {project.url && (
                  <a href={project.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-ai-purple font-semibold hover:underline text-sm">
                    View Live
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SmartCTA -->
  <section class="py-20 bg-slate-900 text-white">
    <div class="container mx-auto px-6 lg:px-8">
      <SmartCTA
        heading="Ready to Start Your Project?"
        text="Let's talk about what you need. I'll give you an honest recommendation and a clear quote."
        primaryWhatsappMessage="Hi Sam, I've been looking at your work. I'd like to discuss a project."
        secondaryLabel="View Services"
        secondaryHref="/services"
      />
    </div>
  </section>

  <!-- Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "My Work",
      "description": "Real projects, real results. Websites, apps, and automation built for UK businesses.",
      "url": "https://f-w-d.co.uk/work",
      "publisher": { "@id": "https://f-w-d.co.uk/#business" },
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": projects.map((p, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "name": p.name,
          "url": p.caseStudy ? `https://f-w-d.co.uk/blog/${p.caseStudy}` : p.url
        }))
      }
    })} />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/layout/Section.astro';
import SmartCTA from '../../components/interactive/SmartCTA.astro';
import { serviceList, fromPrice, gbp, PRICES } from '../../data/services';

const services = serviceList();
---

<Layout
  title="Web Development & Automation Services"
  description={`Websites from ${gbp(PRICES.websites.starter)}, automation from ${gbp(PRICES.automation.simple)}, custom apps from ${gbp(PRICES.apps.smaller)}. Fixed pricing, honest advice, direct communication. See all FWD services.`}
>
  <!-- Hero Section -->
  <section class="relative py-20 bg-slate-900">
    <div class="container relative z-10 mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center text-white">
        <h1 class="text-5xl lg:text-6xl font-bold mb-6">
          Web Development & <span class="text-amber-400">Automation Services</span>
        </h1>
        <p class="text-xl text-gray-100 mb-8">
          Not sure what you need? That's fine. Have a look at what I offer, or just <a href="/contact" class="text-amber-400 hover:underline">get in touch</a> and I'll help you figure it out. No pressure, no obligation.
        </p>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <Section variant="default">
    <div class="grid lg:grid-cols-2 gap-8 max-w-5xl mx-auto" data-stagger>

      {services.map((service, i) => (
        <a
          href={service.href}
          class:list={[
            'bg-white rounded-2xl p-8 shadow-lg border border-gray-100 card-hover group',
            // An odd card out sits centred under the others.
            services.length % 2 === 1 && i === services.length - 1 && 'lg:col-span-2 lg:max-w-lg lg:mx-auto',
          ]}
          data-animate
        >
          <div class="text-4xl mb-4">{service.icon}</div>
          <h2 class="text-2xl font-bold text-slate-900 mb-2 group-hover:text-[var(--colour-primary)] transition-colors">{service.name}</h2>
          <p class="text-sm text-[var(--colour-primary)] font-medium mb-3">{fromPrice(service)}</p>
          <p class="text-gray-600 mb-4">{service.summary}</p>
          <ul class="space-y-2 mb-6">
            {service.highlights.map(feature => (
              <li class="flex items-start gap-2 text-sm text-gray-700">
                <svg class="w-4 h-4 text-green-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                {feature}
              </li>
            ))}
          </ul>
          <span class="text-[var(--colour-primary)] font-semibold inline-flex items-center gap-1">Learn more <span class="arrow-slide">&rarr;</span></span>
        </a>
      ))}

    </div>
  </Section>

  <!-- CTA Section -->
  <Section variant="dark">
    <SmartCTA
      heading="Not Sure What You Need?"
      text="Happy to have a chat about your business and suggest the right approach. No pressure, no obligation."
      primaryWhatsappMessage="Hi Sam, I'm not sure what I need but I'd like to chat about my business."
      secondaryLabel="See Pricing"
      secondaryHref="/pricing"
    />
  </Section>

  <!-- Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "FWD Thinking Solutions - Services",
    "description": "Web development, automation, custom apps, hosting, and AI training for UK businesses",
    "itemListElement": services.map(service => ({
      "@type": "Service",
      "@id": `https://f-w-d.co.uk${service.href}`,
      "name": service.name,
      "description": service.schemaDescription
    }))
  })} />
</Layout>

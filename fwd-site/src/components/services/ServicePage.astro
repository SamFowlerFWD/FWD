---
// One layout for every service page. Content lives in src/data/servicePages.ts,
// names and prices in src/data/services.ts.
import Layout from '../../layouts/Layout.astro';
import SmartCTA from '../interactive/SmartCTA.astro';
import FreshnessBadge from '../content/FreshnessBadge.astro';
import MonthlyPlans from './MonthlyPlans.astro';
import { SERVICES, PRICES, PAY_MONTHLY, fromPrice, gbp } from '../../data/services';
import { projects } from '../../data/projects';
import type { ServicePage } from '../../data/servicePages';

export interface Props {
  page: ServicePage;
}

const { page } = Astro.props;
const service = SERVICES[page.service];
const url = `https://f-w-d.co.uk${service.href}`;
const whatsapp = (message: string) => `https://wa.me/447516330379?text=${encodeURIComponent(message)}`;

// Sections alternate white and grey after the hero, whichever ones a page has.
const bands = [
  'features',
  page.process && 'process',
  'audience',
  page.why && 'why',
  'pricing',
  'related',
  'faq',
].filter(Boolean) as string[];
const isGrey = (band: string) => bands.indexOf(band) % 2 === 1;
const bg = (band: string) => (isGrey(band) ? 'bg-gray-50' : 'bg-white');

const projectCards = (page.projects?.items ?? []).map(item => {
  const project = projects.find(p => p.id === item.id);
  if (!project) throw new Error(`Service page ${page.service}: no project with id "${item.id}"`);
  return {
    ...item,
    name: item.name ?? project.name,
    image: project.image,
    alt: project.alt,
    href: project.caseStudy ? `/blog/${project.caseStudy}` : '/work',
  };
});

const tierPrice = (price: number | null, plus?: boolean) =>
  price === null ? 'Custom' : `${gbp(price)}${plus ? '+' : ''}`;

const offers = [
  ...(page.pricing.tiers ?? []).filter(t => t.price !== null).map(t => ({
    name: t.name,
    price: t.price!,
    monthly: t.monthly,
    description: t.schemaDescription,
  })),
  ...(page.pricing.ranges ?? []).map(r => ({ name: r.name, price: r.price, monthly: false, description: r.schemaDescription })),
  ...(page.pricing.monthlyPlans ? [{
    name: 'Pay Monthly',
    price: PRICES.monthly.from,
    monthly: true,
    description: PAY_MONTHLY.schemaDescription,
  }] : []),
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: page.schema.name,
  serviceType: page.schema.serviceType,
  description: page.schema.description,
  url,
  provider: { '@id': 'https://f-w-d.co.uk/#business' },
  areaServed: [
    { '@type': 'City', name: 'Norwich' },
    { '@type': 'State', name: 'Norfolk' },
    { '@type': 'Country', name: 'United Kingdom' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: service.name,
    itemListElement: offers.map(offer => ({
      '@type': 'Offer',
      name: offer.name,
      price: String(offer.price),
      priceCurrency: 'GBP',
      description: offer.description,
      ...(offer.monthly ? {
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: String(offer.price),
          priceCurrency: 'GBP',
          unitText: 'MONTH',
        },
      } : {}),
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const tick = 'M5 13l4 4L19 7';
---

<Layout title={page.title} description={page.description}>
  <!-- Hero -->
  <section class="relative py-20 bg-slate-900">
    <div class="absolute inset-0 bg-ai-mesh opacity-20"></div>
    <div class="container relative z-10 mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center text-white">
        <h1 class="text-5xl lg:text-6xl font-bold mb-6">
          {page.hero.heading} <span class="text-amber-400">{page.hero.highlight}</span>
        </h1>
        <p class="text-xl text-gray-100 mb-8">{page.hero.intro}</p>
        <p class="text-lg text-amber-400 font-semibold mb-8">{fromPrice(service)}</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={whatsapp(page.cta.whatsapp)} target="_blank" rel="noopener noreferrer" class="bg-amber-500 hover:bg-amber-600 text-white font-bold py-4 px-8 rounded-lg transition-colors shadow-lg inline-block">
            Get in Touch
          </a>
          <a href={page.hero.secondary.href} class="bg-white/10 backdrop-blur-sm border-2 border-white text-white font-bold py-4 px-8 rounded-lg hover:bg-white hover:text-slate-900 transition-all inline-block">
            {page.hero.secondary.label}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class={`py-20 ${bg('features')}`}>
    <div class="container mx-auto px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold text-slate-900 mb-4">{page.features.heading}</h2>
          {page.features.intro && <p class="text-xl text-gray-600">{page.features.intro}</p>}
        </div>
        <div class={page.features.items.some(f => f.examples) ? 'grid md:grid-cols-3 gap-8' : 'grid md:grid-cols-2 lg:grid-cols-3 gap-6'}>
          {page.features.items.map(feature => (
            <div class={`${isGrey('features') ? 'bg-white' : 'bg-gray-50'} rounded-xl p-6`}>
              <div class="text-3xl mb-3">{feature.icon}</div>
              {feature.examples ? (
                <>
                  <h3 class="text-xl font-bold text-slate-900 mb-4">{feature.title}</h3>
                  <ul class="space-y-2">
                    {feature.examples.map(example => (
                      <li class="flex items-start gap-2 text-sm text-gray-700">
                        <svg class="w-4 h-4 text-success-green mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={tick} />
                        </svg>
                        {example}
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <>
                  <h3 class="text-lg font-bold text-slate-900 mb-2">{feature.title}</h3>
                  <p class="text-gray-600 text-sm">{feature.description}</p>
                </>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  {page.process && (
    <section class={`py-20 ${bg('process')}`}>
      <div class="container mx-auto px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-4xl font-bold text-slate-900 mb-4">{page.process.heading}</h2>
            {page.process.intro && <p class="text-xl text-gray-600">{page.process.intro}</p>}
          </div>
          <ol class="space-y-6">
            {page.process.steps.map((step, i) => (
              <li class="flex gap-4">
                <div class="w-10 h-10 bg-amber-500 rounded-full flex items-center justify-center text-white font-bold flex-shrink-0">
                  {i + 1}
                </div>
                <div>
                  <h3 class="text-lg font-bold text-slate-900 mb-1">{step.title}</h3>
                  <p class="text-gray-600">{step.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )}

  <!-- Who it's for, then the projects that prove it -->
  <section class={`${page.projects ? 'pt-16 pb-20' : 'py-16'} ${bg('audience')}`}>
    <div class="container mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-slate-900 mb-6">{page.audience.heading}</h2>
        {page.audience.paragraphs?.map((paragraph, i, all) => (
          <p class={`text-gray-600 leading-relaxed ${i < all.length - 1 ? 'mb-4' : ''}`}>{paragraph}</p>
        ))}
        {page.audience.bullets && (
          <ul class="space-y-4">
            {page.audience.bullets.map(item => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-amber-500 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span class="text-gray-600">{item}</span>
              </li>
            ))}
          </ul>
        )}
      </div>

      {page.projects && (
        <div class={`${projectCards.length > 2 ? 'max-w-5xl' : 'max-w-4xl'} mx-auto mt-16`}>
          <div class="text-center mb-12">
            <h2 class="text-4xl font-bold text-slate-900 mb-4">{page.projects.heading}</h2>
            <p class="text-xl text-gray-600">{page.projects.intro}</p>
          </div>
          <div class={`grid ${projectCards.length > 2 ? 'md:grid-cols-3 gap-6' : 'md:grid-cols-2 gap-8'}`}>
            {projectCards.map(project => (
              <a href={project.href} class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-shadow group flex flex-col">
                <img src={project.image} alt={project.alt} class={`w-full aspect-[16/10] object-cover ${project.position ?? 'object-top'}`} loading="lazy" />
                <div class="p-6 flex flex-col flex-1">
                  <p class="text-sm font-semibold text-amber-600 mb-1">{project.tag}</p>
                  <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-ai-purple transition-colors">{project.name}</h3>
                  <p class="text-gray-600 text-sm mb-4 flex-1">{project.description}</p>
                  <span class="text-ai-purple font-semibold text-sm">Read the case study &rarr;</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Why me -->
  {page.why && (
    <section class={`py-16 ${bg('why')}`}>
      <div class="container mx-auto px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-3xl font-bold text-slate-900 mb-6">{page.why.heading}</h2>
          {page.why.paragraphs.map((paragraph, i, all) => (
            <p class={`text-gray-600 leading-relaxed ${i < all.length - 1 ? 'mb-4' : ''}`} set:html={paragraph} />
          ))}
          {page.why.story && (
            <a href={page.why.story.href} class="mt-8 block bg-white rounded-xl p-6 shadow-sm border-l-4 border-amber-500 hover:shadow-md transition-shadow group">
              <p class="text-sm font-semibold text-amber-600 mb-1">{page.why.story.label}</p>
              <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-ai-purple transition-colors">{page.why.story.title}</h3>
              <p class="text-gray-600 mb-3">{page.why.story.text}</p>
              <span class="text-ai-purple font-semibold text-sm">{page.why.story.linkText} &rarr;</span>
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Pricing -->
  <section id="pricing" class={`py-20 ${bg('pricing')}`}>
    <div class="container mx-auto px-6 lg:px-8">
      <div class={`${page.pricing.tiers ? 'max-w-4xl' : 'max-w-3xl'} mx-auto`}>
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold text-slate-900 mb-4">{page.pricing.heading}</h2>
          <p class="text-xl text-gray-600">{page.pricing.intro}</p>
        </div>

        {page.pricing.tiers && (
          <div class="grid lg:grid-cols-3 gap-8">
            {page.pricing.tiers.map(tier => (
              <div class={tier.featured
                ? 'bg-white rounded-2xl shadow-xl border-2 border-amber-500 p-8 relative'
                : 'bg-white rounded-2xl shadow-lg border border-gray-200 p-8'}>
                {tier.featured && (
                  <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-amber-500 text-white text-sm font-semibold px-4 py-1 rounded-full whitespace-nowrap">
                    MOST POPULAR
                  </div>
                )}
                <div class="text-center mb-6">
                  <h3 class="text-2xl font-bold text-slate-900 mb-2">{tier.name}</h3>
                  <p class="text-gray-600 mb-4">{tier.audience}</p>
                  <div class="text-4xl font-bold text-slate-900 mb-2">{tierPrice(tier.price, tier.plus)}</div>
                  <p class="text-gray-500 text-sm">{tier.per}</p>
                </div>
                <ul class="space-y-3 mb-8">
                  {tier.features.map(item => (
                    <li class="flex items-start gap-2">
                      <svg class="w-5 h-5 text-success-green mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={tick} />
                      </svg>
                      <span class="text-gray-700">{item}</span>
                    </li>
                  ))}
                </ul>
                <a href={whatsapp(page.cta.whatsapp)} target="_blank" rel="noopener noreferrer" class={tier.featured
                  ? 'block w-full text-center bg-amber-500 text-white font-semibold py-3 rounded-lg hover:bg-amber-600 transition-colors'
                  : 'block w-full text-center bg-slate-900 text-white font-semibold py-3 rounded-lg hover:bg-slate-800 transition-colors'}>
                  {tier.cta}
                </a>
              </div>
            ))}
          </div>
        )}

        {page.pricing.ranges && (
          <div class="grid md:grid-cols-2 gap-6">
            {page.pricing.ranges.map(range => (
              <div class="bg-white rounded-xl p-6 text-left shadow-sm">
                <h3 class="text-xl font-bold text-slate-900 mb-2">{range.name}</h3>
                <p class="text-2xl font-bold text-amber-500 mb-3">From {gbp(range.price)}</p>
                <p class="text-gray-600 text-sm mb-4">{range.text}</p>
                <p class="text-gray-500 text-xs">{range.note}</p>
              </div>
            ))}
          </div>
        )}

        {page.pricing.included && (
          <div class="mt-8 text-left bg-white rounded-xl p-6 shadow-sm">
            <h3 class="text-lg font-bold text-slate-900 mb-3">{page.pricing.included.heading}</h3>
            <div class="grid md:grid-cols-2 gap-2">
              {page.pricing.included.items.map(item => (
                <div class="flex items-center gap-2 text-sm text-gray-700">
                  <svg class="w-4 h-4 text-success-green flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={tick} />
                  </svg>
                  {item}
                </div>
              ))}
            </div>
          </div>
        )}

        {page.pricing.note && <p class="mt-8 text-center text-gray-600" set:html={page.pricing.note} />}

        {page.pricing.monthlyPlans && <MonthlyPlans />}
      </div>
    </div>
  </section>

  <!-- Related services -->
  <section class={`py-12 ${bg('related')} border-t border-gray-100`}>
    <div class="container mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">Related Services</h2>
        <div class="grid sm:grid-cols-3 gap-4">
          {page.related.map(({ service: key, text }) => (
            <a href={SERVICES[key].href} class={`${isGrey('related') ? 'bg-white' : 'bg-gray-50'} rounded-lg p-4 hover:bg-gray-100 transition-colors group`}>
              <h3 class="font-semibold text-slate-900 group-hover:text-ai-purple transition-colors">{SERVICES[key].name}</h3>
              <p class="text-sm text-gray-600 mt-1">{text}</p>
            </a>
          ))}
        </div>
        {page.relatedMore && (
          <p class="text-sm text-gray-500 mt-4">
            <a href={page.relatedMore.href} class="text-ai-purple hover:underline">{page.relatedMore.label} &rarr;</a>
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class={`py-20 ${bg('faq')}`}>
    <div class="container mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold text-slate-900 mb-4">Frequently Asked Questions</h2>
        </div>
        <div class="space-y-4">
          {page.faqs.map(item => (
            <details class={`${isGrey('faq') ? 'bg-white' : 'bg-gray-50'} rounded-lg border border-gray-100 group shadow-sm`}>
              <summary class={`p-6 cursor-pointer list-none flex items-center justify-between rounded-lg ${isGrey('faq') ? 'hover:bg-gray-50' : 'hover:bg-gray-100'}`}>
                <span class="font-semibold text-slate-900 pr-4">{item.question}</span>
                <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-6 pb-6">
                <p class="text-gray-600">{item.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Call to action -->
  <section class="py-20 bg-slate-900 text-white">
    <div class="container mx-auto px-6 lg:px-8">
      <SmartCTA
        heading={page.cta.heading}
        text={page.cta.text}
        primaryWhatsappMessage={page.cta.whatsapp}
        secondaryLabel={page.cta.secondary.label}
        secondaryHref={page.cta.secondary.href}
      />
      <div class="text-center mt-6 space-y-2">
        <FreshnessBadge />
        <p class="text-sm text-gray-300">Based in Norwich, Norfolk. Working with businesses across the UK.</p>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>

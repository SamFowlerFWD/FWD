# Local settings for `npm run portal:dev`. Copy this file to .dev.vars (which
# is never committed) and fill in the key.
#
# Use a SANDBOX key here, never the live one:
# sandbox-business.revolut.com > Merchant > APIs > Merchant API > Secret key
REVOLUT_API_KEY=
REVOLUT_API_BASE=https://sandbox-merchant.revolut.com

# Optional: tick bank payments off automatically. A second SANDBOX key with
# Accounts > Transactions set to Read. Requests are signed, so it also needs
# the middle line of the private key made by `npm run revolut:keys`.
REVOLUT_BANK_API_KEY=
REVOLUT_BANK_SIGNING_KEY=
REVOLUT_BANK_API_BASE=https://sandbox-b2b.revolut.com
